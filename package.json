{
  "name": "imagefind",
  "private": true,
  "scripts": {
    "start": "concurrently -n backend,frontend -c blue,green \"npm:start:backend\" \"npm:start:frontend\"",
    "start:backend": "cd backend && . .venv/bin/activate && uvicorn app.main:app --reload --port 8000",
    "start:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
