{
  "name": "imagefind",
  "private": true,
  "scripts": {
    "prestart": "npm run build:frontend",
    "start": "concurrently --kill-others -n backend,tunnel -c blue,magenta \"npm:start:backend\" \"npm:start:tunnel\"",
    "build:frontend": "npm --prefix frontend run build",
    "setup:backend": "node scripts/setup-backend.js",
    "auth:set-password": "node scripts/manage-auth.js set-password",
    "auth:status": "node scripts/manage-auth.js status",
    "auth:revoke-sessions": "node scripts/manage-auth.js revoke-sessions",
    "start:backend": "node scripts/start-backend.js",
    "start:frontend": "cd frontend && npm run dev",
    "start:tunnel": "cloudflared tunnel --url http://127.0.0.1:8000"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
